# Copy to .env.local and adjust for your environment.
# .env.local is gitignored — your local config stays local.

# Frontend (Vite) — trailing slash required, used at build time
VITE_BASE_PATH=/studio/

# Backend (Node.js) — must match VITE_BASE_PATH without trailing slash
URL_PREFIX=/studio

# Server port
PORT=6247

# Vite dev server proxy target (used during `npx vite` dev mode only)
DEV_PROXY_PORT=6247
