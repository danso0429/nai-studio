# Dependencies
node_modules/
frontend/node_modules/

# User data (sessions, images, config)
data/*
# 단, 태그 자동완성 DB(db.csv)는 repo에 포함 — clone하면 자동완성 바로 켜짐
!data/db.csv

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# SDStudio source (only used for reference during development)
# The actual ported source is in frontend/src/
server.js.bak*
*.bak
*.bak.phase*
*-bak
*.preview-bak
ecosystem.config.js

# atomic write 임시 파일 (writeFile→rename 패턴, crash 시 잔존 가능)
*.tmp

# Local environment overrides (never commit)
.env.local
.env.*.local

# Build-time generated metadata (regenerated by update.sh each deploy)
public/build-info.json

# Phase 핸드오프 / 작업 메모 (LLM이 생성한 작업용 문서, public repo에 노출 X)
PHASE*_HANDOFF.md

# 개발자 개인 노트 / 메타 (public repo에 노출 X — 2026-05-20 history sanitize 후 영구 제외)
CLAUDE.md
AGENTS.md
JOURNAL.md
docs/JOURNAL-archive.md
.code-review/
docs/heat-diagnosis/
docs/risum-decode-guide.md
docs/bg-stream-preserve-WIP.md
.audit-pass-*/

# TLS 인증서 / 비밀키 — Tailscale `tailscale cert <host>` 등의 산출물. 절대 commit 금지
*.crt
*.key
*.pem

# 본인 전용 — 다른 설치본으로 옮겨가지 않게 차단
lib/private-track.js
